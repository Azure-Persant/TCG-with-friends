# Copy to .env.local and fill in from your Supabase project:
#   Project Settings -> Data API  (URL and anon/publishable key)
#
# The anon key is PUBLIC -- it ships to the browser. That is fine and by
# design: it grants nothing on its own, because every table is protected by
# Row Level Security. Never put the service_role key in this file; it bypasses
# RLS entirely and must never reach the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
