# Postgres. For Supabase use the connection-pooler URI from
# Project Settings -> Database -> Connection string -> URI.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fci

# Where card images go: "local" or "supabase".
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage

# Only needed when STORAGE_DRIVER=supabase.
# The service-role key bypasses RLS. Never expose it to a browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=card-images

# Politeness. Defaults are deliberately gentle -- see ingest/README.md.
GATCG_MIN_INTERVAL_MS=250
GATCG_IMAGE_CONCURRENCY=4
GATCG_MAX_RETRIES=5
